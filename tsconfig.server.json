{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext", "moduleResolution": "bundler",
    "allowImportingTsExtensions": true, "isolatedModules": true, "noEmit": true,
    "skipLibCheck": true, "strict": true, "noImplicitAny": false,
    "types": ["node"]
  },
  "include": ["api", "server", "shared"]
}
